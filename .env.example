# Environment variables for CreatorFlow AI.
# Copy to .env.local (git-ignored) and fill in the values locally, and add
# them in Vercel → Settings → Environment Variables. Never commit real values.

# ---------------------------------------------------------------------------
# Public (exposed to the browser). Safe by design; data is protected by RLS.
# ---------------------------------------------------------------------------

# Canonical site URL, e.g. https://your-domain.com (optional on Vercel).
NEXT_PUBLIC_APP_URL=

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" key or the newer publishable key (sb_publishable_...).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted as the name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# AI provider for the AI Writer (src/lib/ai). Default provider: anthropic.
# Anthropic API key from console.anthropic.com. Add as a *Secret* in Vercel.
ANTHROPIC_API_KEY=
# Optional overrides.
AI_PROVIDER=
AI_MODEL=

# Image generation for AI Images. Default provider: openai (GPT Image).
# OpenAI API key from platform.openai.com. Add as a *Secret* in Vercel.
OPENAI_API_KEY=
# Optional overrides (default model: gpt-image-1).
IMAGE_PROVIDER=
IMAGE_MODEL=

# Service role / secret key (sb_secret_...). Bypasses Row Level Security.
# Only needed for privileged server jobs (webhooks, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Copy to .env.local and fill in values. Never commit real secrets.

# Public base URL of the app (fallback for email links; set in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings → API Keys.
# Both are public by design (sent to the browser); data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Not needed yet. Added when admin/background jobs require it.
# SUPABASE_SECRET_KEY=

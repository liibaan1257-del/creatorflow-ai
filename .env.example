# Copy to .env.local and fill in values. Never commit real secrets.

# Public base URL of the app (used for metadata, auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Added in upcoming steps ---
# Supabase (public, safe in the browser; protected by Row Level Security)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role (SERVER ONLY — never prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=
